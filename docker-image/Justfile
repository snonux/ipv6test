# Image tag: app version plus runtime-rebuild suffix. Bump it for every
# rebuild; a pushed tag is immutable and must never be overwritten.
VERSION := "1.6.2-runtime20261113"
REGISTRY := "r0.lan.buetow.org:30001"
IMAGE := "ipv6test"

# Build the Docker image
build:
	docker build -t {{IMAGE}}:{{VERSION}} .

# Build and push to f3s registry
f3s: build
	docker tag {{IMAGE}}:{{VERSION}} {{REGISTRY}}/{{IMAGE}}:{{VERSION}}
	docker push {{REGISTRY}}/{{IMAGE}}:{{VERSION}}

# Run locally for testing (httpd listens on 8080 as the non-root app user)
run:
	docker run -it --rm -p 8080:8080 {{IMAGE}}:{{VERSION}}

# Shell into the container for debugging
shell:
	docker run -it --rm {{IMAGE}}:{{VERSION}} /bin/sh
